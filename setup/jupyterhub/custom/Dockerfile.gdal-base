# Use andrejreznik/python-gdal image with specific Python version (3.9+ needed for whitebox)
FROM andrejreznik/python-gdal:py3.12.4-gdal3.9.1

# Ensure pip is up to date and configure for better build performance
RUN python -m pip install --upgrade pip setuptools wheel

# Set environment variables to help with package builds
ENV PIP_NO_CACHE_DIR=1
ENV PIP_PREFER_BINARY=1

# Set up non-root user as required by BinderHub
ARG NB_USER=jovyan
ARG NB_UID=1000
ENV USER=${NB_USER}
ENV NB_USER=${NB_USER}
ENV NB_UID=${NB_UID}
ENV HOME=/home/${NB_USER}

# Install additional system dependencies for Python packages (build tools needed for some packages like duckdb)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    libffi-dev \
    libssl-dev \
    curl \
    wget \
    git \
    --no-install-recommends && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create the non-root user
RUN adduser --disabled-password \
    --gecos "Default user" \
    --uid ${NB_UID} \
    ${NB_USER}

# Install JupyterHub components first
RUN python -m pip install --no-cache-dir \
    notebook \
    jupyterlab \
    jupyterhub

# Install scientific computing packages (force binary wheels to avoid compilation)
RUN python -m pip install --no-cache-dir --only-binary=all \
    scipy \
    matplotlib \
    pandas \
    seaborn

# Install geospatial and visualization packages (prefer binary wheels)
RUN python -m pip install --no-cache-dir --prefer-binary \
    folium \
    plotly \
    dash \
    dash-leaflet

# Install specialized geospatial packages (allow source builds for specialized packages)
RUN python -m pip install --no-cache-dir \
    leafmap \
    localtileserver \
    whitebox \
    pysheds

# Pre-download WhiteboxTools binary as root to avoid permission issues later
RUN python -c "import whitebox; whitebox.download_wbt()" && \
    chmod -R 755 /usr/local/pyenv/versions/3.12.4/lib/python3.12/site-packages/whitebox/

# Install geospatial packages that depend on GDAL (GDAL Python bindings already included in base image)
RUN python -m pip install --no-cache-dir --prefer-binary \
    rasterio \
    geopandas \
    rioxarray

# WhiteboxTools permissions are now handled above during installation

# Switch to jovyan user (WhiteboxTools already downloaded and configured)
USER ${NB_USER}

# Switch back to root for remaining setup
USER root

# Environment variables for geodata/gdal image
# GDAL and PROJ paths are typically already configured in the geodata/gdal image

# Copy repository contents to HOME and set ownership (BinderHub requirement)
COPY . ${HOME}
RUN chown -R ${NB_UID} ${HOME}

# Switch to non-root user
USER ${NB_USER}
WORKDIR ${HOME}

# Set the command that BinderHub will run
CMD ["jupyterhub-singleuser"]